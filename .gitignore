# OS
.DS_Store

# Editors
.vscode/
.idea/

# Temporary files
*.tmp
*.log

# Secrets / environment
.env
.env.*
credentials
credentials.json
*.pem
*.key

# Raw exports that may contain institutional data
data/
exports/
downloads/

# Locally generated production row extracts from the broad KC discovery run.
# Real KCOEUS rows (PII redacted, but still institutional data) - never committed.
# Reproducible via scripts/extract_grants_package.py. The discovery METADATA
# (data dictionary, table manifest, exclusions, extract log) IS tracked under
# discovery/ and is deliberately not covered by this rule.
discovery/output/

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Production metadata regenerated by scripts/build_metadata_inputs.py.
# Schema metadata and row counts only, but still production information.
build/
